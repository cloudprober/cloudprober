import type {
  Reporter, FullConfig, FullResult, Suite, TestCase, TestError, TestStep, TestResult
} from '@playwright/test/reporter';

// Log lines go to stderr with a level prefix, which cloudprober maps to the
// log level (see stderrLogLevel in browser.go).
const debug = (string: string) => process.stderr.write("DEBUG "+string+'\n');
const info = (string: string) => process.stderr.write("INFO "+string+'\n');
const warning = (string: string) => process.stderr.write("WARNING "+string+'\n');

const print = (string: string) => process.stdout.write(string+'\n');

const ansiRe = /\x1b\[[0-9;]*m/g;
// Cloudprober stops reading stderr on a line longer than 256KB, so we cap
// relayed lines well below that.
const maxRelayLineLen = 8192;
// Playwright's own debug logs (enabled through DEBUG=pw:api,pw:browser, etc).
const pwDebugRe = /^\s*(\S+Z\s+)?pw:\S+ /;

// relay logs each line of a chunk of worker output. Playwright captures the
// test workers' stdout/stderr (console.log, DEBUG=pw:* output, etc) and hands
// it only to the reporters, so without this it's lost.
const relay = (log: (string: string) => void, chunk: string|Buffer, test: void|TestCase) => {
  const prefix = test ? `[${test.title}] ` : "";
  for (let line of chunk.toString().split('\n')) {
    line = line.replace(ansiRe, "");
    if (line.trim() === "") {
      continue;
    }
    if (line.length > maxRelayLineLen) {
      line = line.slice(0, maxRelayLineLen) + "... (truncated)";
    }
    (pwDebugRe.test(line) ? debug : log)(prefix+line);
  }
}

const testLabels= (test: TestCase) => {
    var titleLabel = `test="${test.title.replace(/ /g,"_")}"`;

    var suiteLabel = "";
    if (test.parent.title != "") {
        suiteLabel = `,suite="${test.parent.title.replace(/ /g,"_")}"`;
    }

    var tagsLabel = "";
    if (test.tags.length != 0) {
      tagsLabel = `,tags="${test.tags.join(",")}"`;
    }

    return `${titleLabel}${suiteLabel}${tagsLabel}`;
}

class CloudproberReporter implements Reporter {
  // launchStarted / browserReady track how far the browser got before a global
  // timeout, so onEnd can tell a browser-launch failure (an internal error)
  // apart from a test/target stall (a target failure) -- both end in a global
  // timeout with no onTestEnd, so we can't rely on test status.
  //
  // The browser launch is a Playwright API call, so it shows up as a "pw:api"
  // step. launchStarted = a pw:api step began; browserReady = a pw:api step
  // completed without error. Requiring launchStarted (not just !browserReady)
  // avoids a false positive when the run stalls *before* the browser is ever
  // touched -- e.g. a beforeAll/hook doing a plain fetch() against a dead
  // target, which is a target failure, not an internal error. A fresh process
  // (and reporter) is created per probe run, so these reset each cycle.
  //
  // Confirmed empirically against real Playwright:
  //   - mid-test hang: "Launch browser"/"Create context"/"Create page" pw:api
  //     steps end err=0, then "Navigate to ..." hangs -> browserReady true.
  //   - launch hang: "Launch browser" pw:api step begins but never ends before
  //     onEnd -> launchStarted true, browserReady false.
  //   - pre-launch hang (beforeAll raw fetch): only "hook" steps begin, no
  //     pw:api step -> launchStarted false.
  private launchStarted = false;
  private browserReady = false;

  // test.step()s in progress, so that we can tell which steps were running if
  // the run ends abruptly (there is no onStepEnd for them in that case).
  private runningSteps = new Map<TestStep, TestCase>();

  onBegin(config: FullConfig, suite: Suite) {
    info(`Starting the suite "${suite.title}" with ${suite.allTests().length} tests`);
  }

  onTestBegin(test: TestCase) {
    info(`Starting test "${test.title}"`);
  }

  onStepBegin(test: TestCase, result: TestResult, step: TestStep) {
    if (step.category === 'pw:api') {
      this.launchStarted = true;
    }
    if (step.category === 'test.step') {
      this.runningSteps.set(step, test);
      debug(`Starting step "${step.title}" of test "${test.title}"`);
    }
  }

  onStepEnd(test: TestCase, result: TestResult, step: TestStep) {
    if (step.category === 'pw:api' && !step.error) {
      this.browserReady = true;
    }
    if (step.category === 'test.step') {
      this.runningSteps.delete(step);
      if (step.error) {
        // Keep it short: onTestEnd logs the full error.
        const msg = (step.error.message ?? "").replace(ansiRe, "").split('\n')[0];
        warning(`Test step "${step.title}" of test "${test.title}" failed: ${msg}`);
      } else {
        debug(`Test step "${step.title}" of test "${test.title}" passed in ${step.duration}ms`);
      }
      {{- if .EnableStepMetrics }}
      var stepTitle = step.title.replace(/ /g,"_");
      // Not result.status: that's the test's status, which isn't set until
      // the test ends (it reads "skipped" until then).
      var stepStatus = step.error ? "failed" : "passed";

      print(`test_step_status{step="${stepTitle}",${testLabels(test)},status="${stepStatus}"} 1`);
      print(`test_step_latency{step="${stepTitle}",${testLabels(test)},status="${stepStatus}"} ${step.duration*1000}`);
      {{- end }}
    }
  }
  
  onStdOut(chunk: string|Buffer, test: void|TestCase, result: void|TestResult) {
    relay(info, chunk, test);
  }

  onStdErr(chunk: string|Buffer, test: void|TestCase, result: void|TestResult) {
    relay(warning, chunk, test);
  }

  // Errors outside of tests, e.g. a spec file that fails to load.
  onError(error: TestError) {
    warning(`Error: ${JSON.stringify((error.message ?? "").replace(ansiRe, ""))}`);
  }

  onTestEnd(test: TestCase, result: TestResult) {
    if (result.status !== "passed" && result.status !== "skipped") {
      warning(`Test "${test.title}" failed with errors: ${JSON.stringify(result.errors)}`);
    }
    {{ if not .DisableTestMetrics }}
    print(`test_status{${testLabels(test)},status="${result.status}"} 1`);
    print(`test_latency{${testLabels(test)},status="${result.status}"} ${result.duration*1000}`);
    {{ end }}
  }

  onEnd(result: FullResult) {
    // Steps that never ended, e.g. because the test suite timed out. Note that
    // result.status may be "failed" rather than "timedout" here, if an earlier
    // test failed.
    for (const [step, test] of this.runningSteps) {
      warning(`Test step "${step.title}" of test "${test.title}" was still running when the test run ended`);
    }

    // A global timeout (cloudprober's globalTimeout) where the browser launch
    // was started but never completed means the run stalled bringing the
    // browser up -- e.g. a launch failure under resource pressure. Emit a
    // sentinel to stderr so cloudprober counts it as an internal_error (matched
    // by internalErrorRe). If the browser launched (browserReady) or the run
    // never got to launching it (launchStarted false, e.g. a hook hung on a
    // plain fetch), the stall is in the test/target, which is a target failure.
    if (result.status === "timedout" && this.launchStarted && !this.browserReady) {
      warning("[cloudprober-internal-error] test suite timed out during browser launch");
    }
  }
}
export default CloudproberReporter;